<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0B10"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Remoto"
        android:textColor="#EEF0F5"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="Dejá que un amigo vea y controle este teléfono, con tu permiso explícito."
        android:textColor="#8B91A3"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/accessibilityStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="#14151D"
        android:padding="14dp"
        android:textColor="#F8717A"
        android:textSize="13sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#7C5CFF"
        android:text="Compartir mi pantalla" />

    <TextView
        android:id="@+id/codeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="#14151D"
        android:gravity="center"
        android:letterSpacing="0.3"
        android:padding="20dp"
        android:textColor="#EEF0F5"
        android:textSize="30sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="#8B91A3"
        android:textSize="14sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#F8717A"
        android:text="Detener sesión"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Creador: Kelvin Gomez"
        android:textColor="#8B91A3"
        android:textSize="11sp" />

</LinearLayout>
