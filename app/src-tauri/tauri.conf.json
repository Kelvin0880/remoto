{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remoto",
  "version": "0.1.0",
  "identifier": "com.kelvingomez.remoto",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Remoto",
        "width": 920,
        "height": 640,
        "minWidth": 480,
        "minHeight": 400,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost ws://localhost:8787 wss://*.onrender.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
